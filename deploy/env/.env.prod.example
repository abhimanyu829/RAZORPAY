# PRODUCTION — real project, real credentials via secret manager ONLY.
# Start READ-ONLY (3). Shadow (4) after a clean week. Human-approved (5) only
# with finance sign-off. NEVER above 5 on first deploy.
REVENUEGUARD_ENV=prod
REVENUEGUARD_ROLLOUT_LEVEL=3
REVENUEGUARD_LLM_PROVIDER=openai_compat
REVENUEGUARD_LLM_BASE_URL=https://your-llm-endpoint/v1
REVENUEGUARD_LLM_API_KEY=__SET_VIA_SECRET_MANAGER__
REVENUEGUARD_LLM_MODEL=your-model
REVENUEGUARD_DATABASE_URL=postgresql://postgres.__PROJECT__:__PASSWORD__@aws-0-__REGION__.pooler.supabase.com:6543/postgres
# real webhook secrets — rotate quarterly (Section 60)
REVENUEGUARD_WEBHOOK_SECRET_RAZORPAY=__SET_VIA_SECRET_MANAGER__
REVENUEGUARD_WEBHOOK_SECRET_SHOPIFY=__SET_VIA_SECRET_MANAGER__
RAZORPAY_KEY_ID=__SET_VIA_SECRET_MANAGER__
RAZORPAY_KEY_SECRET=__SET_VIA_SECRET_MANAGER__
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=__SET_VIA_SECRET_MANAGER__
