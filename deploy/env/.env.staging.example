# STAGING — Supabase staging project, sandbox connectors, real LLM (strict)
REVENUEGUARD_ENV=staging
# read-only / shadow in staging: never execute financial side effects
REVENUEGUARD_ROLLOUT_LEVEL=4
REVENUEGUARD_LLM_PROVIDER=openai_compat
REVENUEGUARD_LLM_BASE_URL=https://your-llm-endpoint/v1
REVENUEGUARD_LLM_API_KEY=__SET_VIA_SECRET_MANAGER__
REVENUEGUARD_LLM_MODEL=your-model
REVENUEGUARD_DATABASE_URL=postgresql://postgres.__PROJECT__:__PASSWORD__@aws-0-__REGION__.pooler.supabase.com:6543/postgres
# test-mode webhook secrets
REVENUEGUARD_WEBHOOK_SECRET_RAZORPAY=__TEST_WEBHOOK_SECRET__
REVENUEGUARD_WEBHOOK_SECRET_SHOPIFY=__TEST_WEBHOOK_SECRET__
RAZORPAY_KEY_ID=rzp_test___
RAZORPAY_KEY_SECRET=__TEST_SECRET__
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=__DEV_STORE_TOKEN__
